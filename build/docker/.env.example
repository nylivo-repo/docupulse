# DocuPulse IDP Docker settings. Copy to .env next to docker-compose.yml and edit.

# Image tag loaded from the bundle (docker load -i docupulse-idp-images.tar.gz)
IDP_VERSION=1.5.0

# Ports on the NAS. Browsers use https://<nas-address>:HTTPS_PORT. Pick ports nothing else uses
# (UGOS itself uses 9999/9443). HTTP_PORT only redirects to HTTPS.
HTTPS_PORT=7443
HTTP_PORT=7080

# Owner of the ./data folder on the NAS (run `id` as that user). Files are written as this user.
PUID=1000
PGID=1000

# Names and addresses in the self-signed certificate (first start only; delete data/certs/* to redo).
# Example: DNS:nas01,DNS:nas01.local,IP:192.168.1.50
TLS_SUBJECT_ALT_NAMES=

# With a certificate browsers trust (not self-signed), turn on HSTS:
# HSTS_HEADER=max-age=31536000
HSTS_HEADER=

# Largest request Nginx accepts, in MB. Keep above [storage] max_upload_mb in data/config/server.ini.
MAX_BODY_MB=30

# Private network between the two containers. Change only if it clashes with another Docker network.
IDP_SUBNET=172.30.80.0/24
IDP_WEB_IP=172.30.80.10
IDP_API_IP=172.30.80.11
IDP_TUNNEL_IP=172.30.80.12

# Optional public access (testing): a Cloudflare tunnel token, used only with
#   docker compose --profile public up -d
# Keep this file private (chmod 600 .env); anyone with the token can serve the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

TZ=UTC
