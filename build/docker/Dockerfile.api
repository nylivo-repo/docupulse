# IDP API image (FastAPI on Python 3.12). Built by build/docker/make-bundle.sh from the project root:
#   docker build -f build/docker/Dockerfile.api -t idp-api .
# Runs with no internet: every package and the OCR models are inside the image.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    IDP_HOST=0.0.0.0 IDP_PORT=8000 IDP_SERVE_FRONTEND=false \
    PUID=1000 PGID=1000

WORKDIR /app/backend
COPY backend/requirements.txt /tmp/requirements.txt
# Servers have no display libraries: the headless OpenCV build replaces the one RapidOCR pulls in
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
 && pip uninstall -y opencv-python \
 && pip install --no-cache-dir opencv-python-headless \
 && rm /tmp/requirements.txt

COPY backend/ /app/backend/
# The .example.ini templates are copied into the config volume on every start (live .ini files are kept)
RUN mkdir -p /app/config-defaults && cp /app/backend/config/*.example.ini /app/config-defaults/ \
 && rm -f /app/backend/config/*.ini
COPY build/docker/api-entrypoint.sh /usr/local/bin/idp-entrypoint
RUN chmod 755 /usr/local/bin/idp-entrypoint

EXPOSE 8000
VOLUME ["/app/backend/config", "/app/backend/storage"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"
ENTRYPOINT ["idp-entrypoint"]
CMD ["python", "run.py"]
